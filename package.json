{
  "name": "ohrbob-bootstrap",
  "version": "1.0.0",
  "scripts": {
    "build": "sass --quiet-deps scss/theme.scss css/theme.css && node scripts/capture-screenshot.mjs",
    "watch": "sass --watch --quiet-deps scss/theme.scss css/theme.css",
    "test": "node --test 'test/**/*.test.mjs'",
    "apply": "./scripts/apply-theme.sh"
  },
  "dependencies": {
    "bootstrap": "^5.3.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "puppeteer": "^25.12.0",
    "sass": "^1.70.0"
  }
}
